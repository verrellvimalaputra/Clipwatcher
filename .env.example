# Copy this file to .env and fill it in. .env is never committed.
STUDIO_PASSWORD=change-me            # browser login password (any username)
PUBLIC_URL=                          # e.g. https://studio.yourdomain.com (needed for Instagram + TikTok)
CLAUDE_CODE_OAUTH_TOKEN=             # output of `claude setup-token` (Claude Pro/Max, no API key)
CLAUDE_MODEL=sonnet                  # model alias Claude Code uses
CLIPWATCHER_DEMO=0                   # 1 = run the whole flow without really posting
